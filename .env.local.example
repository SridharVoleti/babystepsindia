# --- Local dev mode (current default — SQLite + built-in session auth) ---
# Random secret used to sign local session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
APP_LAUNCH_BOOTSTRAP_SECRET=
# JSON object mapping app_service_principals.key_ref to that app's unique
# confidential backend secret. Never expose this value to browser code.
APP_SERVICE_SECRETS={}
# Ed25519 key pair for LA-002 backend-only API access tokens. During rotation,
# APP_ACCESS_VERIFY_KEYS retains old public keys by key id until issued tokens expire.
APP_ACCESS_SIGNING_PRIVATE_KEY=
APP_ACCESS_SIGNING_PUBLIC_KEY=
APP_ACCESS_SIGNING_KEY_ID=
APP_ACCESS_VERIFY_KEYS={}
LEARNING_SESSION_SECRET=

# Where the local SQLite file lives. Auto-created on first run.
SQLITE_DB_PATH=./data/babysteps.db

# Seeded once on first run if no admin exists yet. Change these or just
# log in with the defaults printed in the server console on first boot.
ADMIN_EMAIL=admin@babysteps.in
ADMIN_PASSWORD=changeme123

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AN-001 — dedicated secret for HMAC-deriving the daily pseudonymous
# learner key. Deliberately separate from AUTH_SECRET/LEARNING_SESSION_SECRET
# (business rule/Security & Privacy: "Analytics secret is separate from
# authentication/signing secrets"). Generate the same way as AUTH_SECRET.
ANALYTICS_HMAC_SECRET=
# Scheduler's separately rotated managed-service signing secret. Production
# stores its server-side counterpart under the scheduler principal's key_ref
# in PLATFORM_SERVICE_SECRETS; contributors use a different key and identity.
ANALYTICS_SCHEDULER_SERVICE_SECRET=
PLATFORM_SERVICE_SECRETS={}
# Public HTTPS origin of the deployed platform. The AN-001 GitHub Actions
# scheduler stores this value as the ANALYTICS_BASE_URL repository secret.
ANALYTICS_BASE_URL=

# --- Production target (REQ-08 §2) — Baby Steps Supabase project ---
# Unused while running in local SQLite mode; kept here for when the app is
# ported back onto Supabase per the architecture doc.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (used by the webhook handler, REQ-08 §6 — not yet wired in this pass)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
